# Local development values only. Copy to .env and change passwords before sharing a network.
CASEFLOW_MODE=offline_test
DATABASE_URL=postgresql+psycopg://caseflow_app:caseflow_app_dev@127.0.0.1:5432/caseflow
SEED_DATABASE_URL=postgresql+psycopg://caseflow_seed:caseflow_seed_dev@127.0.0.1:5432/caseflow
POSTGRES_USER=caseflow_admin
POSTGRES_PASSWORD=caseflow_admin_dev
CASEFLOW_APP_PASSWORD=caseflow_app_dev
CASEFLOW_SEED_PASSWORD=caseflow_seed_dev
CASEFLOW_CHECKPOINT_PASSWORD=caseflow_checkpoint_dev
CASEFLOW_ACTION_PASSWORD=caseflow_action_dev
CASEFLOW_EMBEDDING_INDEX_PASSWORD=caseflow_embedding_index_dev
TEST_DATABASE_URL=postgresql+psycopg://caseflow_app:caseflow_app_dev@127.0.0.1:5432/caseflow_test
TEST_SEED_DATABASE_URL=postgresql+psycopg://caseflow_seed:caseflow_seed_dev@127.0.0.1:5432/caseflow_test
CHECKPOINT_DATABASE_URL=postgresql://caseflow_checkpoint:caseflow_checkpoint_dev@127.0.0.1:5432/caseflow
TEST_CHECKPOINT_DATABASE_URL=postgresql://caseflow_checkpoint:caseflow_checkpoint_dev@127.0.0.1:5432/caseflow_test
ACTION_EXECUTOR_DATABASE_URL=postgresql+psycopg://caseflow_action_executor:caseflow_action_dev@127.0.0.1:5432/caseflow
EMBEDDING_INDEX_DATABASE_URL=postgresql+psycopg://caseflow_embedding_indexer:caseflow_embedding_index_dev@127.0.0.1:5432/caseflow
CASEFLOW_MCP_SERVER_URL=http://127.0.0.1:8001/mcp
CASEFLOW_MCP_HOST=127.0.0.1
CASEFLOW_MCP_PORT=8001
CASEFLOW_MCP_TOOL_TIMEOUT_SECONDS=8
CASEFLOW_DATABASE_NAME=caseflow
CASEFLOW_API_HOST_PORT=8000
CASEFLOW_MCP_HOST_PORT=8001

# Needed only for live mode. The application never returns these values.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
# To opt into a small local model instead of the external API, uncomment and use:
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_DIMENSIONS=512
# EMBEDDING_CACHE_DIR=.tmp/fastembed_cache
CASEFLOW_STRUCTURED_OUTPUT_METHOD=json_schema
CASEFLOW_SYNTHESIS_REASONING_EFFORT=none
CASEFLOW_DECISION_TIMEOUT_SECONDS=10
CASEFLOW_SYNTHESIS_TIMEOUT_SECONDS=10
CASEFLOW_DECISION_MAX_TOKENS=900
CASEFLOW_SYNTHESIS_MAX_TOKENS=2048

CASEFLOW_MAX_MODEL_CALLS=10
CASEFLOW_MAX_TOOL_CALLS=8
CASEFLOW_MAX_AGENT_SECONDS=25
CASEFLOW_SQL_STATEMENT_TIMEOUT_MS=3000
