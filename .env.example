# Local development values only. Copy to .env and change passwords before sharing a network.
CASEFLOW_MODE=offline_test
DATABASE_URL=postgresql+psycopg://caseflow_app:caseflow_app_dev@127.0.0.1:5432/caseflow
SEED_DATABASE_URL=postgresql+psycopg://caseflow_seed:caseflow_seed_dev@127.0.0.1:5432/caseflow
POSTGRES_USER=caseflow_admin
POSTGRES_PASSWORD=caseflow_admin_dev
CASEFLOW_APP_PASSWORD=caseflow_app_dev
CASEFLOW_SEED_PASSWORD=caseflow_seed_dev
TEST_DATABASE_URL=postgresql+psycopg://caseflow_app:caseflow_app_dev@127.0.0.1:5432/caseflow_test
TEST_SEED_DATABASE_URL=postgresql+psycopg://caseflow_seed:caseflow_seed_dev@127.0.0.1:5432/caseflow_test

# Needed only for live mode. The application never returns these values.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

CASEFLOW_MAX_TOOL_CALLS=8
CASEFLOW_MAX_AGENT_SECONDS=25
CASEFLOW_SQL_STATEMENT_TIMEOUT_MS=3000
